<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="when_started" id="hat1" x="50" y="50">
    <next>
      <block type="drive_distance" id="drive1">
        <field name="DIRECTION">forward</field>
        <field name="DISTANCE">200</field>
        <field name="UNIT">mm</field>
        <next>
          <block type="forever" id="loop1">
            <statement name="DO">
              <block type="wait" id="wait1">
                <value name="SECONDS">
                  <shadow type="math_number" id="n1">
                    <field name="NUM">1</field>
                  </shadow>
                </value>
                <next>
                  <block type="boolean_and" id="and1">
                    <value name="A">
                      <block type="bumper_pressed" id="bump1">
                        <field name="BUMPER">left</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="boolean_or" id="or1">
                        <value name="A">
                          <block type="distance_found_object" id="dist1">
                            <field name="SENSOR">front</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
