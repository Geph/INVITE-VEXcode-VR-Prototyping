{
  "name": "invite-vexcode-vr-prototyping",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "collab": "node scripts/collab-server.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "dev:all": "concurrently -n next,collab -c blue,green \"npm run dev\" \"npm run collab\"",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "blockly": "13.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.18"
  }
}
